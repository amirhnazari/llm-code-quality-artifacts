% Documentation for the radon implementation actually used. VERIFIED twice: the
% page documents MI = max[0, 100(171 - 5.2 ln V - 0.23 G - 16.2 ln L
% + 50 sin(sqrt(2.4 C)))/171], and the installed source agrees --- radon 6.0.1
% metrics.py mi_compute() returns min(max(0, nn_mi * 100/171), 100). Author and
% release date verified against the PyPI JSON API (6.0.1 uploaded 2023-03-26).
% LOYAL USE: cite ONLY for the normalized 0-100 derivative. The underlying
% four-component formula belongs to Coleman et al. --- do not merge the two.
% NOTE: this derivative converts the comment percentage to radians before the
% sine (math.radians in mi_compute), an implementation quirk of radon, not of
% the original MI. The docs page also calls MI "still a very experimental metric"
% --- available as extra support for the thesis's MI critique if ever needed.
@misc{radon_docs,
  author = {Lacchia, Michele},
  title  = {Radon documentation: introduction to code metrics},
  note   = {Software documentation, version 6.0.1, released 2023-03-26},
  url    = {https://radon.readthedocs.io/en/v6.0.1/intro.html},
  year   = {2023}
}


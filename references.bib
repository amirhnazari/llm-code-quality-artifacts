% Canonical Maintainability Index source --- the paper Heitlager et al. cite as
% their ref [7] for the MI. VERIFIED against Crossref (DOI 10.1109/2.303623) AND
% read in full: sources/coleman1994maintainability.pdf.
% The final four-metric polynomial is
%   Maintainability = 171 - 5.2*ln(aveVol) - 0.23*aveV(g') - 16.2*ln(aveLOC)
%                     + (50 * sin(sqrt(2.46 * perCM)))
% i.e. Halstead VOLUME (they switched from effort due to its nonmonotonicity),
% extended cyclomatic complexity, LOC, and PERCENT comments (perCM replaced a raw
% comment count, which over-inflated small modules; capped at 50).
% NOTE on faithful use: this formula is UNBOUNDED (it starts at 171); the 0-100
% range reported in this study is radon's normalization --- cite radon_docs for
% that, never Coleman. Also: Coleman's inputs are AVERAGES PER SUBMODULE, so do
% not attribute a per-module reading to them.
@article{coleman1994maintainability,
  author  = {Coleman, Don and Ash, Dan and Lowther, Bruce and Oman, Paul},
  title   = {Using metrics to evaluate software system maintainability},
  journal = {Computer},
  volume  = {27},
  number  = {8},
  pages   = {44--49},
  year    = {1994},
  doi     = {10.1109/2.303623}
}


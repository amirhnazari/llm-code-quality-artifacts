% Bibliography for paper.tex
% Style: IEEEtran (numeric). Titles use IEEE sentence case; acronyms/proper
% nouns are brace-protected. Internal "VERIFY" reminders are kept as % comments
% so they never render in the printed bibliography.
%
% WARNING: BibTeX does NOT treat "%" as a comment character. A bare at-sign
% anywhere in this file --- including inside a "%" line --- makes BibTeX try to
% parse a new entry and abort with "I was expecting a brace or a paren", which
% surfaces as every citation being undefined. So never write an entry type with
% its leading at-sign in a comment: write "misc entry", not the at-prefixed form.
% scripts/check-citations.sh lints for this.

% IEEEtran style control. Turns off the repeated-author dash so that an entry
% sharing authors with the preceding one prints the names in full ("J. Liu, ...")
% instead of "------". Both forms are valid IEEE style; the full form is used here
% so that every entry in the reference list has the same visible structure.
% Activated by \bstctlcite in paper.tex, which must come before any real citation.
@IEEEtranBSTCTL{BSTcontrol,
  CTLdash_repeated_names = "no"
}

